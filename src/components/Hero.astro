---
import { getImage } from 'astro:assets';
import Button from './Button.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  framedImage: ImageMetadata;
  framedImageAlt?: string;
  framedVideo?: string;
  subtitle?: string;
  primaryCta?: string;
  secondaryCta?: string;
  primaryHref?: string;
  secondaryHref?: string;
  primaryVariant?: 'primary' | 'dark' | 'outline' | 'outlineLight' | 'link';
}
const {
  framedImage,
  framedImageAlt = '',
  framedVideo,
  subtitle,
  primaryCta = 'Check Availability',
  secondaryCta = 'Explore Iceland Photography Tours',
  primaryHref = '/tours',
  secondaryHref = '/tours',
  primaryVariant = 'primary',
} = Astro.props;

const posterSrc = (await getImage({ src: framedImage, width: 1600, quality: 80 })).src;
---

<div class="home-hero-wrap" style="padding:0 var(--space-8) var(--space-8)">
  <section style="position:relative;min-height:85vh;border-radius:32px;overflow:hidden;display:flex;align-items:flex-end;justify-content:center">
    {framedVideo ? (
      <video src={framedVideo} autoplay muted loop playsinline preload="auto" poster={posterSrc} style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover"></video>
    ) : (
      <img src={posterSrc} alt={framedImageAlt} style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover" />
    )}
    <div class="hero-fade" style="position:absolute;inset:0;background:linear-gradient(to bottom, rgba(230,227,218,0) 50%, #E6E3DA 92%)"></div>
    <div style="position:relative;width:100%;display:flex;flex-direction:column;gap:var(--space-6);align-items:center;text-align:center;padding:0 var(--space-9) var(--space-11)">
      <div style="display:flex;flex-direction:column;gap:var(--space-4);align-items:center">
        <h1 class="hero-title hero-anim" style="font:400 36px/1.25 var(--font-display);color:var(--text-heading);margin:0;max-width:60%;animation-delay:200ms">
          <slot name="title" />
        </h1>
        {subtitle ? <p class="hero-anim" style="font:400 18px/1.6 var(--font-sans);color:var(--text-body);margin:0;max-width:600px;animation-delay:900ms">{subtitle}</p> : null}
      </div>
      <div class="hero-ctas hero-anim" style="justify-content:center;animation-delay:1600ms">
        {primaryCta ? <Button variant={primaryVariant} href={primaryHref}>{primaryCta}</Button> : null}
        {secondaryCta ? <Button variant="outline" href={secondaryHref} iconAfter="arrow-right">{secondaryCta}</Button> : null}
      </div>
      <slot />
    </div>
  </section>
</div>

<style>
  /* Plays automatically on load — the hero is always above the fold, so
     unlike the rest of the site this never waits on a scroll observer. */
  .hero-anim {
    opacity: 0;
    transform: translateY(26px);
    animation: hero-fade-up 1400ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  @keyframes hero-fade-up {
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-anim { opacity: 1; transform: none; animation: none; }
  }
  @media (max-width: 640px) {
    .home-hero-wrap { padding: 0 var(--space-6) var(--space-6) !important; }
    .hero-title { font-size: 1.75rem !important; max-width: 100% !important; }
    /* the wrapped title takes up much more vertical space on narrow
       screens, so it needs the fade to start earlier to stay legible */
    .hero-fade { background: linear-gradient(to bottom, rgba(230,227,218,0) 40%, #E6E3DA 85%) !important; }
  }
</style>

<style is:global>
  /* keeps the page background flush with the hero's own fade color, so the
     rounded card doesn't show a seam against a differently-toned page bg */
  body:has(.home-hero-wrap) { background: #E6E3DA !important; }
</style>
